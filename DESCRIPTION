Package: bgnormR
Type: Package
Title: Background Normalisation for Multiplex Spatial Proteomics
Version: 0.99.3
Authors@R: c(
    person("Dharmesh D.", "Bhuva", role = c("aut", "cre"),
           email = "dhrmsh36@gmail.com",
           comment = c(ORCID = "0000-0002-6398-9157")),
